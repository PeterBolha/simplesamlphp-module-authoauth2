{% set subPageTitle = subPageTitle ?? '' %}
{% set pagetitle = 'OpenID Connect Federation' ~ (subPageTitle ? ' | ' ~ subPageTitle : '') %}

{% extends "base.twig" %}

{% block preload %}
    <link rel="stylesheet" href="{{ asset('css/admin.css', 'admin') }}">
    <link rel="stylesheet" href="{{ asset('css/src/default.css', 'authoauth2') }}">
{% endblock %}

{% block content %}

    {% if menu is defined and menu is not empty %}
        {%- include "@admin/includes/menu.twig" %}
    {% endif %}

    <h2>{{ 'OpenID Connect Federation'|trans }}</h2>

    <div class="authoauth2-container">

        {% if moduleMenu is defined and moduleMenu is not empty %}
            <div class="menu">
                <ul>
                    {% for item in moduleMenu %}
                        <li>
                            <a href="{{ item.url|e }}"
                               class="{{ item.route == activeModuleRoute ? 'active' : '' }}"
                            >{{ item.label|trans }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <div class="content">
            {% if subPageTitle %}
                <h3>{{ subPageTitle|trans }}</h3>
            {% endif %}

            {% block authoauth2Content %}{% endblock %}
        </div>
    </div>

{% endblock content -%}
