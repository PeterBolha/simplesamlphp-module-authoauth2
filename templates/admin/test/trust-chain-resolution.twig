{% set subPageTitle = 'Test Trust Chain Resolution'|trans %}

{% extends "@authoauth2/admin/base.twig" %}

{% block authoauth2Content %}

    <p>
        {{ 'Resolve a trust chain from a leaf entity ID to one or more trust anchors. The form is pre-filled with this RP entity ID and the configured trust anchors.'|trans }}
    </p>

    <form method="post" action="{{ testUrl|e }}" class="pure-form pure-form-stacked">
        <fieldset>
            <label for="leafEntityId">{{ 'Leaf Entity ID'|trans }}</label>
            <input type="text" name="leafEntityId" id="leafEntityId" class="full-width" required
                   value="{{ leafEntityId|e }}">

            <label for="trustAnchorIds">{{ 'Trust Anchor IDs'|trans }}</label>
            <textarea name="trustAnchorIds" id="trustAnchorIds" rows="4" class="full-width"
                      required>{{ trustAnchorIds|e }}</textarea>
            <span class="pure-form-message">{{ 'One trust anchor ID per line.'|trans }}</span>

            <br>
            <button type="submit" class="pure-button">{{ 'Resolve'|trans }}</button>
        </fieldset>
    </form>

    {% if isFormSubmitted %}
        <h4>{{ 'Log messages'|trans }}</h4>
        {% if logMessages is not empty %}
            <ul>
                {% for message in logMessages %}
                    <li><code>{{ message|e }}</code></li>
                {% endfor %}
            </ul>
        {% else %}
            <p>{{ 'No warnings or errors.'|trans }}</p>
        {% endif %}

        <h4>{{ 'Resolved chains'|trans }}</h4>
        {% if trustChainBag %}
            <p>{{ 'Total chains'|trans }}: {{ trustChainBag.getCount }}</p>
            {% for index, trustChain in trustChainBag.getAll %}
                <h5>{{ 'Chain'|trans }} {{ loop.index }} — {{ 'Trust Anchor'|trans }}:
                    {{ trustChain.getResolvedTrustAnchor.getIssuer|e }}</h5>
                <div class="code-box"><code>{{ 'Path'|trans }}:
{% for entity in trustChain.getEntities %}{% if loop.index > 1 %}
  &seArr; {% endif %}{{ entity.getSubject|e }}{% endfor %}</code></div>
                <p>{{ 'Expires'|trans }}: {{ trustChain.getResolvedExpirationTime|date('Y-m-d H:i:s T')|e }}</p>
                {% if resolvedMetadata[index] is not empty %}
                    <div class="code-box"><code>{{ resolvedMetadata[index]|json_encode(constant('JSON_PRETTY_PRINT'))|e }}</code></div>
                {% else %}
                    <p>{{ 'No resolved metadata.'|trans }}</p>
                {% endif %}
                {% if not loop.last %}<hr>{% endif %}
            {% endfor %}
        {% else %}
            <p>{{ 'No chains resolved.'|trans }}</p>
        {% endif %}
    {% endif %}

{% endblock authoauth2Content -%}
