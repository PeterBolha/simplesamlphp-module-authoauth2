{% set subPageTitle = 'Status'|trans %}

{% extends "@authoauth2/admin/base.twig" %}

{% block authoauth2Content %}

    <table class="attributes pure-table pure-table-striped">
        <tr><th>{{ 'Entity ID'|trans }}</th><td>{{ status.entityId|e }}</td></tr>
        <tr><th>{{ 'Statement lifetime'|trans }}</th><td>{{ status.lifetime|e }}</td></tr>
        <tr><th>{{ 'Token endpoint auth method'|trans }}</th><td>{{ status.tokenEndpointAuthMethod|e }}</td></tr>
        <tr><th>{{ 'Statement cache'|trans }}</th>
            <td>{{ status.cacheEnabled ? 'enabled'|trans : 'disabled'|trans }}</td></tr>
        <tr><th>{{ 'Trust marks published'|trans }}</th><td>{{ status.trustMarkCount }}</td></tr>
        <tr><th>{{ 'Trust anchors'|trans }}</th>
            <td>
                {%- for ta in status.trustAnchors %}{{ ta|e }}{% if not loop.last %}<br>{% endif %}{% else %}
                {{ 'none'|trans }}{% endfor -%}
            </td></tr>
        <tr><th>{{ 'Authority hints'|trans }}</th>
            <td>
                {%- for hint in status.authorityHints %}{{ hint|e }}{% if not loop.last %}<br>{% endif %}{% else %}
                {{ 'none'|trans }}{% endfor -%}
            </td></tr>
        <tr><th>{{ 'Scopes'|trans }}</th><td>{{ status.scopes|join(' ')|e }}</td></tr>
        <tr><th>{{ 'Redirect URIs'|trans }}</th>
            <td>
                {%- for uri in status.redirectUris %}{{ uri|e }}{% if not loop.last %}<br>{% endif %}{% else %}
                {{ 'none'|trans }}{% endfor -%}
            </td></tr>
    </table>

    <h4>{{ 'Federation signing keys'|trans }}</h4>
    {% if status.keys is not empty %}
        <table class="attributes pure-table pure-table-striped">
            <tr>
                <th>{{ 'Algorithm'|trans }}</th>
                <th>{{ 'Key ID'|trans }}</th>
                <th>{{ 'Public key'|trans }}</th>
            </tr>
            {% for key in status.keys %}
                <tr>
                    <td>{{ key.algorithm|e }}</td>
                    <td>{{ key.keyId is not empty ? key.keyId|e : '(JWK thumbprint)'|trans }}</td>
                    <td>
                        {{ key.publicKey|e }}
                        {% if not key.publicKeyExists %}
                            <strong>({{ 'file missing'|trans }})</strong>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </table>
    {% else %}
        <p>{{ 'No federation keys configured.'|trans }}</p>
    {% endif %}

    <h4>{{ 'Entity configuration statement'|trans }}</h4>
    {% if status.statement.error %}
        <p><strong>{{ 'The entity configuration statement could not be built: %err%.'|trans({'%err%': status.statement.error}) }}</strong></p>
    {% else %}
        <table class="attributes pure-table pure-table-striped">
            <tr><th>{{ 'Issued at'|trans }}</th>
                <td>{{ status.statement.issuedAt ? status.statement.issuedAt|date('Y-m-d H:i:s T')|e : 'n/a'|trans }}</td></tr>
            <tr><th>{{ 'Expires at'|trans }}</th>
                <td>{{ status.statement.expiresAt ? status.statement.expiresAt|date('Y-m-d H:i:s T')|e : 'n/a'|trans }}</td></tr>
            <tr><th>{{ 'Seconds remaining'|trans }}</th><td>{{ status.statement.secondsRemaining }}</td></tr>
        </table>
    {% endif %}

    <h4>{{ 'Federation-enabled auth sources'|trans }}</h4>
    {% if status.authSources is not empty %}
        <table class="attributes pure-table pure-table-striped">
            <tr>
                <th>{{ 'Name'|trans }}</th>
                <th>{{ 'OP issuer'|trans }}</th>
                <th>{{ 'Own trust anchors'|trans }}</th>
            </tr>
            {% for source in status.authSources %}
                <tr>
                    <td>{{ source.name|e }}</td>
                    <td>{{ source.issuer|e }}</td>
                    <td>{{ source.hasOwnTrustAnchors ? 'yes'|trans : 'no'|trans }}</td>
                </tr>
            {% endfor %}
        </table>
    {% else %}
        <p>{{ 'No auth source of this module uses the federation option.'|trans }}</p>
    {% endif %}

{% endblock authoauth2Content -%}
